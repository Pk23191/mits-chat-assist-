# CampusAssist AI Environment Configuration Example
# Copy to .env and configure your local settings

APP_NAME=CampusAssist AI
APP_ENV=development
LOG_LEVEL=INFO

# CORS Configuration (comma-separated origins or JSON array)
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# AI Generation Provider: 'gemini', 'ollama', or 'auto'
AI_PROVIDER=gemini

# Google Gemini Configuration
# Obtain your free API key at: https://aistudio.google.com/
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash

# Local Ollama Configuration (alternative or fallback provider)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=minicpm-v4.6:1b

# Embedding & Retrieval Configuration
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Optional custom directory containing model weights (leave empty to use default Hugging Face cache)
EMBEDDING_MODEL_DIR=
# Set to 1/true to force offline embedding loading without network checks
HF_HUB_OFFLINE=

# Knowledge Base & Vector Store
DATA_DIR=data
VECTOR_STORE_DIR=data/vectorstore
CHROMA_COLLECTION=campusassist_faq

# Ingestion & Chunking Parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=4
RETRIEVAL_MAX_DISTANCE=0.75
MAX_DOCUMENT_BYTES=5000000
MAX_PDF_PAGES=100

# Institutional Crawler Parameters
MITS_FETCH_DELAY=2.0
MITS_FETCH_TIMEOUT=30.0
