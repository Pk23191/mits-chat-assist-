APP_NAME=CampusAssist AI
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
GEMINI_API_KEY=
DATA_DIR=data
VECTOR_STORE_DIR=data/vectorstore
CHROMA_COLLECTION=campusassist_faq
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_TOP_K=4
RETRIEVAL_MAX_DISTANCE=0.75
MAX_DOCUMENT_BYTES=5000000
MAX_PDF_PAGES=100
MITS_FETCH_DELAY=2.0
MITS_FETCH_TIMEOUT=30.0
